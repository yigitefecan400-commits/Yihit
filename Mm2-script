-- 1. Modern ve Güçlü Fly Mekanizması
local flying = false
local speed = 1500
local flyConnection

ToggleBtn.MouseButton1Click:Connect(function()
    flying = not flying
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if flying then
        ToggleBtn.Text = "Fly (1500): AÇIK"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        hum.PlatformStanding = true

        flyConnection = runService.RenderStepped:Connect(function()
            if not flying or not hrp or not char.Parent then return end
            local cam = workspace.CurrentCamera
            hrp.AssemblyLinearVelocity = cam.CFrame.LookVector * speed
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
        end)
    else
        ToggleBtn.Text = "Fly (1500): KAPALI"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        hum.PlatformStanding = false
        if flyConnection then flyConnection:Disconnect() end
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
end)

