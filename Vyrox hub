-- 1. Fly (WASD Destekli ve Kamera Uyumlu Hale Getirildi)
local flying = false
local flySpeed = 60
local flyConnection

ToggleBtn.MouseButton1Click:Connect(function()
    flying = not flying
    if flying then
        ToggleBtn.Text = "Fly (WASD): AÇIK"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)

        flyConnection = runService.RenderStepped:Connect(function()
            if not flying then return end
            local char = localPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end

            hum.PlatformStanding = true
            local cam = workspace.CurrentCamera
            local moveDir = hum.MoveDirection
            
            if moveDir.Magnitude > 0 then
                -- Kamera açısına göre yönü hesapla
                local camCFrame = cam.CFrame
                local lookV = camCFrame.LookVector
                local rightV = camCFrame.RightVector
                
                -- Yalnızca yatay düzlemde yön belirleme
                local flatLook = Vector3.new(lookV.X, 0, lookV.Z).Unit
                local flatRight = Vector3.new(rightV.X, 0, rightV.Z).Unit
                
                -- Karakterin klavye girdisine göre yönlendirilmesi
                local moveVelocity = (flatLook * (hum.MoveDirection:Dot(flatLook)) + flatRight * (hum.MoveDirection:Dot(flatRight))) * flySpeed
                hrp.AssemblyLinearVelocity = Vector3.new(moveVelocity.X, 0, moveVelocity.Z)
            else
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        ToggleBtn.Text = "Fly (WASD): KAPALI"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if flyConnection then flyConnection:Disconnect() end
        local char = localPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum then hum.PlatformStanding = false end
            if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        end
    end
end)

