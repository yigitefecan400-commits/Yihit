-- 6. ESP
local espEnabled = false
local espConnections = {}

local function applyHighlight(p)
    if p ~= localPlayer then
        local function setup(char)
            if espEnabled and not char:FindFirstChild("YigitHighlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "YigitHighlight"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Parent = char
            end
        end
        if p.Character then setup(p.Character) end
        table.insert(espConnections, p.CharacterAdded:Connect(setup))
    end
end

EspBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    EspBtn.Text = espEnabled and "ESP (Herkesi Gör): AÇIK" or "ESP (Herkesi Gör): KAPALI"
    EspBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
    
    if espEnabled then
        for _, p in ipairs(game.Players:GetPlayers()) do
            applyHighlight(p)
        end
        table.insert(espConnections, game.Players.PlayerAdded:Connect(applyHighlight))
        table.insert(espConnections, game.Players.PlayerRemoving:Connect(function(p)
            if p.Character then
                local hl = p.Character:FindFirstChild("YigitHighlight")
                if hl then hl:Destroy() end
            end
        end))
    else
        for _, conn in ipairs(espConnections) do
            conn:Disconnect()
        end
        espConnections = {}
        local playersList = game.Players:GetPlayers()
        for i = 1, #playersList do
            local p = playersList[i]
            if p.Character then
                local hl = p.Character:FindFirstChild("YigitHighlight")
                if hl then hl:Destroy() end
            end
        end
    end
end)

